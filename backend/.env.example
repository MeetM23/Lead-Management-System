# Local development settings. Copy this file to .env and fill in your own values. Never commit .env.

# Your local XAMPP/MariaDB database (create it in phpMyAdmin first, see README.md).
# XAMPP's default login is user "root" with no password:  mysql://root@localhost:3306/leadflow
# If you set a password:                                   mysql://root:YOUR_PASSWORD@localhost:3306/leadflow
# (special characters in a password must be URL-encoded, e.g. @ becomes %40)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/leadflow"

# A separate, empty database used only by the automated database tests. Its name must end in _test.
TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/leadflow_test"

# Signing key for login tokens: at least 32 random characters, or the server will not start.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Port for the API (defaults to 5000). The frontend expects http://localhost:5000.
PORT=5000

# Use development locally
NODE_ENV=development

# Demo data: off by default. To create demo users and leads, set ENABLE_SEEDING=true,
# give SEED_DEMO_PASSWORD a password (8+ characters), then run: npm run seed
ENABLE_SEEDING=false
SEED_DEMO_PASSWORD=

# Limits for importing leads from Excel/CSV (optional; these are the defaults)
IMPORT_MAX_FILE_MB=5
IMPORT_MAX_ROWS=5000

# Hosting only: the website address(es) allowed to call the API, comma-separated, no trailing path.
# Leave empty locally (the Vite dev server is allowed by default).
# Example: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=
